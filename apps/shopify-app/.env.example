# Copy to .env and fill in. Never commit real values.
# Shopify CLI normally injects SHOPIFY_API_KEY/SECRET for local dev.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders

# Durable stores + encryption. Both are required together in production.
MONGODB_URI=
# Base64 of exactly 32 random bytes, e.g. `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=

# TechLadder API.
TECHLADDER_BASE_URL=
# Per-shop keys are pasted in the app; this env key is a staging-only fallback.
TECHLADDER_API_KEY=
TECHLADDER_WEBHOOK_TOLERANCE=300
# Keep unset until the backend supports idempotent POST /calls everywhere.
TECHLADDER_SINGLE_CALL=

# Optional display override; otherwise derived from the shop domain.
STORE_DISPLAY_NAME=

# Only needed for the local Prisma/SQLite session-storage fallback.
DATABASE_URL=file:./dev.sqlite
